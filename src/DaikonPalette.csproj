<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rider での開発用プロジェクト。利用者向けの正式ビルドは build.bat（Windows付属の csc.exe）。
    csc.exe は C# 5 までなので LangVersion=5 に固定し、C# 6 以降の構文を Rider 上でエラーにする。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>5</LangVersion>
    <RootNamespace>DaikonPalette</RootNamespace>
    <AssemblyName>DaikonPalette</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
    <!-- バージョン等は AssemblyInfo.cs で管理（build.bat と共通にするため自動生成しない） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 静的チェック（.editorconfig の規約を Rider / dotnet build で表示する） -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Web.Extensions"/>
  </ItemGroup>

  <!-- .NET Framework 4.8 Developer Pack が無い環境でもビルドできるように（開発時のみ・配布物には含まれない） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
  </ItemGroup>

  <!-- build.bat の /resource と同じ名前で埋め込む（ウィンドウのアイコン） -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" LogicalName="DaikonPalette.app.ico"/>
    <None Remove="Resources\app.png"/>
  </ItemGroup>

  <!-- Rider から実行したとき用に、初期の単語・テンプレートを出力先にコピー -->
  <ItemGroup>
    <None Include="..\data\*.json" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

</Project>
